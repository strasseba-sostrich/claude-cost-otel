{
  "kind": "Dashboard",
  "metadata": {
    "name": "prompt",
    "project": "ai-agents"
  },
  "spec": {
    "display": {
      "name": "Prompt",
      "description": "One prompt end to end. Open it from Recent prompts on Agent cost, or choose a prompt here."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "traceId",
          "display": {
            "name": "Prompt trace",
            "description": "Prompts from the last 3 hours, taken from Loki log events. Clicking a row in Recent prompts selects it."
          },
          "allowAllValue": false,
          "allowMultiple": false,
          "plugin": {
            "kind": "LokiLogQLVariable",
            "spec": {
              "expr": "sum by (trace_id) (count_over_time({service_name=\"claude-code\"} | trace_id != \"\" [3h]))",
              "labelName": "trace_id"
            }
          }
        }
      }
    ],
    "panels": {
      "promptTimeline": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Prompt timeline",
            "description": "One prompt end to end: LLM requests, tool calls, subagents and permission waits."
          },
          "plugin": {
            "kind": "TracingGanttChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TraceQuery",
              "spec": {
                "plugin": {
                  "kind": "JaegerTraceQuery",
                  "spec": {
                    "traceId": "$traceId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Prompt timeline"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 18,
              "content": {
                "$ref": "#/spec/panels/promptTimeline"
              }
            }
          ]
        }
      }
    ],
    "duration": "1h",
    "refreshInterval": "0s"
  }
}
